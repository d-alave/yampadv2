#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        grab_x: grab_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <200>;
            tap-ms = <30>;
            bindings
                = <&macro_tap &kp G>
                , <&macro_tap &kp X>
                ;
        };
        
        grab_y: grab_y {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <200>;
            tap-ms = <30>;
            bindings
                = <&macro_tap &kp G>
                , <&macro_tap &kp Y>
                ;
        };
        
        grab_z: grab_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <200>;
            tap-ms = <30>;
            bindings
                = <&macro_tap &kp G>
                , <&macro_tap &kp Z>
                ;
        };

        default_view: default_view {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <200>;
            tap-ms = <30>;
            bindings
                = <&macro_tap &kp KP_N1>
                , <&macro_tap &kp KP_N5>
                , <&macro_tap &kp HOME>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            sensor-bindings = <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>;
            bindings = <
                &kp ESCAPE       &kp B       &kp D       &kp L
                &kp TAB          &kp S       &kp R       &kp LSHIFT 
                &kp E            &kp A       &kp Y
                &kp G            &kp X       &kp Z
                &mo 1            &mo 2       &kp LALT    &kp LCTRL 
            >;
        };

        layer_1 { 
            sensor-bindings = <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>;
            bindings = <
                &kp LC(Z)        &kp LC(LS(Z))    &kp LS(TAB)      &kp F12
                &kp F2           &kp F3           &kp H            &kp LC(S) 
                &kp I            &kp TILDE        &grab_y
                &grab_x          &grab_z          &kp KP_EQUAL
                &none            &mo 3            &kp ENTER        &default_view
            >;
        };

        layer_2 { 
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
                &kp BACKSPACE    &kp KP_DIVIDE    &kp KP_MULTIPLY  &kp KP_MINUS
                &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS 
                &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
                &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
                &mo 1            &kp KP_DOT       &mo 3            &kp KP_NUMBER_0 
            >;
        };

        layer_3 { 
            sensor-bindings = <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>;
            bindings = <
                &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &none
                &out OUT_BLE     &out OUT_USB     &bt BT_CLR       &none
                &none            &none            &none
                &none            &none            &none
                &none            &none            &none            &none
            >;
        };
    };
};
