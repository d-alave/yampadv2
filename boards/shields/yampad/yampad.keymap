#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        grab_x: grab_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <200>;
            tap-ms = <30>;
            bindings
                = <&macro_tap &kp G>
                , <&macro_tap &kp X>
                ;
        };
        
        grab_y: grab_y {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <200>;
            tap-ms = <30>;
            bindings
                = <&macro_tap &kp G>
                , <&macro_tap &kp Y>
                ;
        };
        
        grab_z: grab_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <200>;
            tap-ms = <30>;
            bindings
                = <&macro_tap &kp G>
                , <&macro_tap &kp Z>
                ;
        };

        default_view: default_view {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <200>;
            tap-ms = <30>;
            bindings
                = <&macro_tap &kp KP_N1>
                , <&macro_tap &kp KP_N5>
                , <&macro_tap &kp HOME>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            sensor-bindings = <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>;  // Zoom in/out
            bindings = <
                &kp ESCAPE       &kp B       &kp D       &kp L
                &kp TAB          &kp S       &kp R       &mo 2 
                &kp E            &kp A       &kp Y
                &kp LSHIFT       &kp X       &kp Z       &mo 1
                &kp LCTRL        &kp LALT    &kp G     
            >;
        };

        layer_1 { 
            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;  // Pan left/right
            bindings = <
                &kp LC(Z)        &kp LC(LS(Z))    &kp LS(TAB)      &kp F12
                &kp F2           &kp F3           &kp H            &kp ENTER 
                &kp I            &kp TILDE        &grab_y
                &kp T            &grab_x          &grab_z          &none
                &mo 3            &none            &kp N        
            >;
        };

        layer_2 { 
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;  // Volume up/down
            bindings = <
                &kp BACKSPACE    &kp KP_DIVIDE    &kp KP_MULTIPLY  &kp KP_MINUS
                &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none 
                &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
                &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_EQUAL
                &kp KP_DOT       &kp KP_NUMBER_0  &kp KP_PLUS           
            >;
        };

        layer_3 { 
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;  // Volume up/down
            bindings = <
                &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &none
                &out OUT_BLE     &out OUT_USB     &bt BT_CLR       &none
                &none            &none            &none
                &none            &none            &none            &none    
                &none            &none            &none            
            >;
        };
    };
};
